# Copy this file to .env, then replace both passwords.
# Generate strong ones with:  openssl rand -base64 24
# Never commit .env or send it by chat/email.

# Password of the PostgreSQL user "saltfork". Only read the FIRST time the
# database is created; changing it later here does not change the database.
POSTGRES_PASSWORD=change-me-db

# Login for https://<your-site>/export (CSV download of all responses).
# The app refuses to start while ADMIN_PASS is "change-me".
ADMIN_USER=admin
ADMIN_PASS=change-me

# Port on 127.0.0.1 where the app listens for the reverse proxy.
APP_PORT=8000
